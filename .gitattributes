# Normalise line endings. Without this, git's autocrlf on Windows rewrites
# checked-out files to CRLF and gofmt then reports every Go file as unformatted.
* text=auto eol=lf

# Shell scripts and configs must stay LF: they run inside Linux containers, and
# CRLF here produces the classic "bad interpreter: no such file or directory".
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile  text eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# Capture data is binary; never let git touch it.
*.pcap   binary
*.pcapng binary
*.gz     binary
*.png    binary
